    .hub-title { font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--white); margin-bottom: 1rem; line-height: 1.2; }
    .hub-sub { font-size: 1rem; color: rgba(250,248,244,0.6); max-width: 560px; line-height: 1.75; }
    .hub-body { padding: 4rem 2rem; background: var(--parchment); }

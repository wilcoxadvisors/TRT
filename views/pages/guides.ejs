          <div class="guide-icon"><%= g.icon %></div>
          <div class="guide-content">
            <h2 class="guide-title"><%= g.title %></h2>
            <p class="guide-desc"><%= g.description %></p>
            <div class="guide-meta">
              <span class="guide-readtime"><%= g.readTime %></span>
            </div>
          </div>
        </a>
        <% }); %>
      </div>

      <div style="margin-top:2.5rem;padding:1.75rem;background:var(--ink);border-radius:8px;display:flex;flex-direction:column;gap:1.25rem;align-items:center;text-align:center;">
        <p style="font-size:1.1rem;font-weight:600;color:var(--white);margin:0;">Ready to see these clinics in action?</p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
          <a href="/reviews" style="background:var(--gold);color:var(--ink);font-weight:700;font-size:0.875rem;padding:0.65rem 1.5rem;border-radius:6px;text-decoration:none;">Browse all 9 reviews →</a>
          <a href="/comparison" style="background:rgba(250,248,244,0.08);color:var(--white);font-weight:600;font-size:0.875rem;padding:0.65rem 1.5rem;border-radius:6px;text-decoration:none;border:1px solid rgba(250,248,244,0.2);">Comparison table →</a>
        </div>
      </div>

      <div style="margin-top:2.5rem;padding:1.5rem;background:var(--parchment-dark);border:1px solid var(--border);border-radius:8px;">
        <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--ink-soft);margin-bottom:0.75rem;">TRT education hub</p>
        <p style="font-size:0.875rem;color:var(--ink-soft);margin-bottom:1rem;">Before you pick a clinic, understand what you're buying. Six evidence-based articles — no medical advice, no fluff.</p>
        <a href="/learn" style="color:var(--gold-dark);font-weight:600;font-size:0.875rem;text-decoration:none;">Browse all articles →</a>
      </div>
    </div>

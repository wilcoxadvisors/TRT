    .legal-page { max-width: 720px; margin: 0 auto; padding: 3rem 2rem 6rem; }
    .legal-page h1 { font-size: 2.25rem; color: var(--ink); margin-bottom: 0.5rem; }
    .legal-meta { font-size: 0.8rem; color: var(--muted); margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
    .legal-page p { font-size: 0.95rem; color: var(--ink-soft); line-height: 1.8; margin-bottom: 1.25rem; }
    .coming-soon { background: var(--parchment-dark); border: 1px solid var(--border); border-radius: 8px; padding: 2rem; text-align: center; }
    .coming-soon .emoji { font-size: 3rem; margin-bottom: 1rem; }
    .level-<%= topic.level.toLowerCase() %> { background: rgba(201,168,76,0.1); color: var(--gold-dark); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 3px 8px; border-radius: 4px; display: inline-block; }
  </style>
</head>
<body>
  <%- include('../partials/header', { currentPath: '/learn/' + topic.slug }) %>

  <div class="legal-page">
    <h1><%= topic.icon %> <%= topic.title %></h1>
    <div class="legal-meta"><span class="level-<%= topic.level.toLowerCase() %>"><%= topic.level %></span> &nbsp;&middot;&nbsp; TRT Education</div>

    <p><%= topic.description %></p>

    <div class="coming-soon">
      <div class="emoji"><%= topic.icon %></div>
